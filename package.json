{
  "name": "@cocreate/server",
  "version": "2.0.0",
  "description": "The master entry point wrapper for the CoCreate ecosystem. Orchestrates a highly scalable, multi-tenant server infrastructure architecture with dynamic process auto-scaling, federated cross-database routing, and real-time distributed network state synchronization.",
  "keywords": [
    "server",
    "websocket",
    "cluster",
    "control-plane",
    "auto-scaling",
    "distributed-systems",
    "multi-tenant",
    "load-balancing",
    "database-federation",
    "state-synchronization",
    "pubsub",
    "microservices",
    "infrastructure",
    "mesh-network",
    "realtime"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/CoCreate-server.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/CoCreate-server/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/server",
  "type": "module",
  "main": "./src/index.js",
  "scripts": {
    "build:ai": "node scripts/build-plugins.js ai",
    "build:plugins": "node scripts/build-plugins.js",
    "build:storages": "node scripts/build-storages.js",
    "verify:plugins": "node scripts/verify-plugins.js",
    "verify:storages": "node scripts/verify-storages.js",
    "build": "webpack --config webpack.config.js",
    "verify:node": "node scripts/verify-node.js",
    "package:node": "yarn verify:storages && yarn verify:plugins && yarn build && yarn verify:node && bash scripts/package-node-archive.sh",
    "build:dev": "bash scripts/build-node-dev.sh",
    "release:dev": "bash scripts/release-node-dev.sh",
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "createdb": "node ./installation/createDB.js"
  },
  "dependencies": {
    "@cocreate/ai": "^1.0.0",
    "@cocreate/cron": "^2.0.0",
    "@cocreate/notification": "^2.0.0",
    "@cocreate/organizations": "^2.0.0",
    "@cocreate/cluster": "^2.0.0",
    "@cocreate/workflows": "^1.0.0",
    "@cocreate/usage": "^2.0.0",
    "@cocreate/users": "^2.0.0"
  },
  "devDependencies": {
    "@cocreate/cli": "^2.0.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  }
}
